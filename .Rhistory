#Use this to assess Normality
qqPlot(drinkersdata$Treatment, groups=drinkersdata$TotalScore)
#Use this to assess Normality
qqPlot(coughdata$Treatment, groups=coughdata$TotalScore)
#Use this to assess Normality
qqPlot(coughdata$TotalScore, groups=coughdata$Treatment)
#Use this to assess equal variance
bartlett.test(TotalScore~Treatment, data=coughdata)
boxplot(TotalScore~Treatment, data=coughdata)
#Perform ANOVA
#One Factor ANOVA Test
sickanova<-aov(TotalScore~Treatment, data=coughdata)
summary(sickanova)

library(car)
library(blorr)
library(glmtoolbox)
library(ggplot2)
linregmodel <- lm(Survive ~ Area, data=burns)
summary(linregmodel)
#Residual Analysis for Assumptions
#Lack of Fit - Residual Plots
residualPlots(linregmodel, tests = F)
#constant variance - residual plots and residual vs fitted
plot(linregmodel, which=c(1,2))
#hist/qqplot - normality assumption
hist(residuals(linregmodel))
linregmodel <- lm(Survive ~ Area, data=burns)
summary(linregmodel)
#Residual Analysis for Assumptions
#Lack of Fit - Residual Plots
residualPlots(linregmodel, tests = F)
#constant variance - residual plots and residual vs fitted
plot(linregmodel, which=c(1,2))
#hist/qqplot - normality assumption
hist(residuals(linregmodel))
#prediction
predict(linregmodel,interval="predict",level=.95)[1,]
linregmodel <- lm(Survive ~ Area^2+Area, data=burns)
summary(linregmodel)
#Residual Analysis for Assumptions
#Lack of Fit - Residual Plots
residualPlots(linregmodel, tests = F)
#constant variance - residual plots and residual vs fitted
plot(linregmodel, which=c(1,2))
#hist/qqplot - normality assumption
hist(residuals(linregmodel))
linregmodel <- lm(Survive ~ Area + I(Area^2), data = burns)
summary(linregmodel)
#Residual Analysis for Assumptions
#Lack of Fit - Residual Plots
residualPlots(linregmodel, tests = F)
#constant variance - residual plots and residual vs fitted
plot(linregmodel, which=c(1,2))
#hist/qqplot - normality assumption
hist(residuals(linregmodel))

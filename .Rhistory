# in this case we have k = 8 and n = 67
n<-df.residual(gasmod5)+length(coef(gasmod5))
n
#leverage cutoff
# hi > 2(k+1)/n
levcutoff <- (2*(length(coef(gasmod5))))/n
levcutoff
#cook's distance cutoff
# di > 4/n
cookcutoff <- 4/n
cookcutoff
#First we will store the DFFits to make them easier to work with
gasmoddffits<-dffits(gasmod5)
# Calling the observation numbers (row names)
# don't get too worried on the syntax
gasmoddffits[c("64","65","36","53")]
summary(dffits(gasmod5))
gasmodfbeta<-dfbetas(gasmod5)
gasmodfbeta[c("64","65","36","53"),]
gasmodfbeta<-dfbetas(gasmod5)
gasmodfbeta[c("64","65","36","53"),]
summary(gasmodfbeta(penmodfinal))
gasmodfbeta<-dfbetas(gasmod5)
gasmodfbeta[c("64","65","36","53"),]
summary(dfbetas(gasmod5))
#cooks distance threshold
plot(gasmod5,which=4)
#leverage vs studentized residuals - how to interpret this graph?
#also gives the hat/leverage values
influencePlot(gasmod5, fill = FALSE, id = list(n = 5))
ols_plot_resid_stud_fit(gasmod5)
which(hatvalues(gasmod5)>levcutoff)
which(abs(stdres(gasmod5))>2)
which(cooks.distance(gasmod5)>4/67)
which(abs(rstudent(gasmod5))>2)
